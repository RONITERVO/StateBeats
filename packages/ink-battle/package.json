{
  "name": "@statebeats/ink-battle",
  "version": "0.3.0",
  "description": "Ink-Battle collaboration: reproducible battles, sketchbook art and rhythm encounters",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "upstream",
    "recordings",
    "audio",
    "PROVENANCE.json",
    "NOTICE"
  ],
  "exports": {
