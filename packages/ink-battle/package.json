      "import": "./src/visuals.js"
    },
    "./audio/*": "./audio/*",
    "./upstream/*": "./upstream/*"
  },
  "dependencies": {
    "@statebeats/core": "0.3.0",
    "@statebeats/sdk": "0.3.0"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RONITERVO/StateBeats.git",
    "directory": "packages/ink-battle"
  },
  "homepage": "https://github.com/RONITERVO/StateBeats/tree/main/packages/ink-battle#readme",
  "bugs": {
    "url": "https://github.com/RONITERVO/StateBeats/issues"
  }
}
